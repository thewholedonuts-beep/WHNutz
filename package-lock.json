{
  "name": "thewholedonuts-universe",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "thewholedonuts-universe",
      "version": "1.0.0",
      "workspaces": [
        "shared",
        "packages/*",
        "apps/*"
      ]
    },
    "apps/dashboard": {
      "name": "@thewholedonuts/app-dashboard",
      "version": "1.0.0",
      "dependencies": {
        "@thewholedonuts/api": "1.0.0"
      }
    },
    "apps/web": {
      "name": "@thewholedonuts/app-web",
      "version": "1.0.0",
      "dependencies": {
        "@thewholedonuts/web-ui": "1.0.0"
      }
    },
    "node_modules/@thewholedonuts/api": {
      "resolved": "packages/api",
      "link": true
    },
    "node_modules/@thewholedonuts/app-dashboard": {
      "resolved": "apps/dashboard",
      "link": true
    },
    "node_modules/@thewholedonuts/app-web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@thewholedonuts/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@thewholedonuts/emotional-intelligence": {
      "resolved": "packages/emotional-intelligence",
      "link": true
    },
    "node_modules/@thewholedonuts/shared": {
      "resolved": "shared",
      "link": true
    },
    "node_modules/@thewholedonuts/web-ui": {
      "resolved": "packages/web-ui",
      "link": true
    },
    "packages/api": {
      "name": "@thewholedonuts/api",
      "version": "1.0.0",
      "dependencies": {
        "@thewholedonuts/emotional-intelligence": "1.0.0"
      }
    },
    "packages/cli": {
      "name": "@thewholedonuts/cli",
      "version": "1.0.0",
      "dependencies": {
        "@thewholedonuts/api": "1.0.0"
      }
    },
    "packages/emotional-intelligence": {
      "name": "@thewholedonuts/emotional-intelligence",
      "version": "1.0.0",
      "dependencies": {
        "@thewholedonuts/shared": "1.0.0"
      }
    },
    "packages/web-ui": {
      "name": "@thewholedonuts/web-ui",
      "version": "1.0.0",
      "dependencies": {
        "@thewholedonuts/emotional-intelligence": "1.0.0",
        "@thewholedonuts/shared": "1.0.0"
      }
    },
    "shared": {
      "name": "@thewholedonuts/shared",
      "version": "1.0.0"
    }
  }
}
